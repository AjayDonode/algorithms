rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── User profiles ─────────────────────────────────────────
    match /users/{uid} {
      allow read:  if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid;
      // Admins can read all user profiles (for the admin panel)
      allow read:  if request.auth != null && request.auth.token.admin == true;
    }

    // ── Scratchpads ───────────────────────────────────────────
    match /scratchpads/{uid}/items/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ── Blog posts ────────────────────────────────────────────
    match /posts/{postId} {
      allow read:   if resource.data.isDraft == false;
      allow read:   if request.auth != null && request.auth.token.admin == true;
      allow create: if request.auth != null && request.auth.token.admin == true;
      allow update: if request.auth != null && request.auth.token.admin == true;
      allow delete: if request.auth != null && request.auth.token.admin == true;
    }

    // ── Shared Scratchpads ────────────────────────────────────
    match /sharedScratchpads/{docId} {
      allow read:   if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null
                    && request.auth.uid == resource.data.ownerUid;
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.ownerUid;
    }

    // ── Interview Categories ──────────────────────────────────
    // Anyone can read categories; only admins can create/update/delete.
    match /interviewCategories/{categoryId} {
      allow read:   if true;
      allow create: if request.auth != null && request.auth.token.admin == true;
      allow update: if request.auth != null && request.auth.token.admin == true;
      allow delete: if request.auth != null && request.auth.token.admin == true;
    }

    // ── Interview Questions ───────────────────────────────────
    // Public: anyone can read approved questions.
    // Authenticated users can submit (status must be 'pending').
    // Admins can read all statuses and update/delete any question.
    match /interviewQuestions/{questionId} {
      allow read:   if resource.data.status == 'approved';
      allow read:   if request.auth != null && request.auth.token.admin == true;
      allow create: if request.auth != null
                    && request.resource.data.status == 'pending'
                    && request.resource.data.submittedBy == request.auth.uid;
      allow update: if request.auth != null && request.auth.token.admin == true;
      allow delete: if request.auth != null && request.auth.token.admin == true;
    }
  }
}
